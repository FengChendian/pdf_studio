<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="pdf_studio.Views.PdfViewerPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:pdf_studio.Views"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Border
      Grid.Row="0"
      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
      BorderThickness="0,0,0,1"
      Padding="12,8"
      Height="Auto"
    >
      <TextBlock
        x:Name="FileNameLabel"
        Text="PDF Document"
        FontSize="14"
        VerticalAlignment="Center"
        TextTrimming="CharacterEllipsis"
      />
    </Border>

    <!-- Loading overlay -->
    <Border
      Grid.Row="1"
      x:Name="LoadingOverlay"
      Background="Transparent"
      VerticalAlignment="Stretch"
      Height="Auto"
    >
      <ProgressRing
        x:Name="LoadingIndicator"
        IsActive="True"
        Width="40"
        Height="40"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
      />
    </Border>

    <!-- PDF Content -->
    <ScrollView
      Grid.Row="1"
      x:Name="PdfScrollViewer"
      Visibility="Collapsed"
      ZoomMode="Enabled"
      MinZoomFactor="0.25"
      MaxZoomFactor="4.0"
      HorizontalScrollMode="Auto"
      VerticalScrollMode="Auto"
      HorizontalScrollBarVisibility="Auto"
      VerticalScrollBarVisibility="Auto"
      HorizontalAlignment="Center"
      Height="Auto"
      ViewChanged="PdfScrollViewer_ViewChanged"
    >
      <ItemsRepeater
        x:Name="PagesRepeater"
        HorizontalAlignment="Center"
        Margin="32"
        ItemsSource="{x:Bind VirtualizingImages, Mode=OneWay}"
      >
        <ItemsRepeater.Layout>
          <StackLayout Orientation="Vertical" Spacing="16" />
        </ItemsRepeater.Layout>

        <ItemsRepeater.ItemTemplate>
          <DataTemplate>
            <Image Source="{Binding}" Stretch="Uniform" Margin="0,0,0,0" />
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </ScrollView>
  </Grid>
</Page>
