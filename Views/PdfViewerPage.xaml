<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="pdf_studio.Views.PdfViewerPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:pdf_studio.Views">
  <Page.Resources>
    <!-- ListViewItem chrome stripped to a plain presenter: no selection
         visuals, no padding, no min-size.  The 16 DIP bottom margin is the
         inter-page spacing — it must match PageSpacingDips in code-behind. -->
    <Style x:Key="PageItemContainerStyle"
           TargetType="ListViewItem">
      <Setter Property="Padding"
              Value="0"/>
      <Setter Property="Margin"
              Value="0,0,0,16"/>
      <Setter Property="MinWidth"
              Value="0"/>
      <Setter Property="MinHeight"
              Value="0"/>
      <Setter Property="HorizontalContentAlignment"
              Value="Stretch"/>
      <Setter Property="VerticalContentAlignment"
              Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <ContentPresenter
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <!-- Transparent background keeps the whole page hit-testable for
       window-level drag & drop (e.g. gaps between PDF pages). -->
  <Grid Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="S"
                           Modifiers="Control"
                           Invoked="OnSaveAccelerator"/>
      <KeyboardAccelerator Key="Z"
                           Modifiers="Control"
                           Invoked="OnUndoAccelerator"/>
    </Grid.KeyboardAccelerators>

    <!-- ══ Toolbar: [TOC] | [highlight pen + colors] | [page x / y] ══ -->
    <Border
      Grid.Row="0"
      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
      BorderThickness="0,0,0,1"
      Padding="8,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: table of contents -->
        <ToggleButton
          x:Name="TocToggle"
          Grid.Column="0"
          Checked="TocToggle_Toggled"
          Unchecked="TocToggle_Toggled"
          ToolTipService.ToolTip="目录">
          <FontIcon Glyph="&#xE8A4;"
                    FontSize="16"/>
        </ToggleButton>

        <!-- Center: highlight pen + color palette -->
        <StackPanel
          Grid.Column="1"
          Orientation="Horizontal"
          HorizontalAlignment="Center"
          Spacing="8">
          <ToggleButton
            x:Name="HighlightPenToggle"
            Checked="HighlightPenToggle_Toggled"
            Unchecked="HighlightPenToggle_Toggled"
            ToolTipService.ToolTip="高亮笔">
            <FontIcon Glyph="&#xE76D;"
                      FontSize="16"/>
          </ToggleButton>

          <StackPanel
            x:Name="ColorPalettePanel"
            Orientation="Horizontal"
            Spacing="6"
            VerticalAlignment="Center"
            Visibility="Collapsed"/>
        </StackPanel>

        <!-- Right: page navigation - editable current page + total.
             Shows the live page number while unfocused; typing digits and
             pressing Enter jumps via the same path as TOC navigation. -->
        <StackPanel
          Grid.Column="2"
          Orientation="Horizontal"
          VerticalAlignment="Center"
          Spacing="4">
          <TextBox
            x:Name="PageNumberBox"
            Width="40"
            MinHeight="0"
            MinWidth="0"
            IsEnabled="False"
            BorderThickness="0"
            TextAlignment="Center"
            FontSize="13"
            Padding="4,1"
            BeforeTextChanging="PageNumberBox_BeforeTextChanging"
            TextChanging="PageNumberBox_TextChanging"
            KeyDown="PageNumberBox_KeyDown"
            LostFocus="PageNumberBox_LostFocus"
            ToolTipService.ToolTip="输入页码后按回车跳转"/>
          <TextBlock
            x:Name="PageTotalLabel"
            VerticalAlignment="Center"
            FontSize="13"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="/ –"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ══ Content: PDF pages + floating TOC pane ══ -->
    <Grid Grid.Row="1">
      <Grid>
        <!-- Loading overlay -->
        <Border x:Name="LoadingOverlay"
                Background="Transparent">
          <ProgressRing
            x:Name="LoadingIndicator"
            IsActive="True"
            Width="40"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>
        </Border>

        <!-- PDF Content -->
        <ScrollView
          x:Name="PdfScrollViewer"
          Visibility="Collapsed"
          ZoomMode="Enabled"
          MinZoomFactor="0.25"
          MaxZoomFactor="4.0"
          HorizontalScrollMode="Auto"
          VerticalScrollMode="Auto"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Auto"
          HorizontalAlignment="Stretch"
          ViewChanged="PdfScrollViewer_ViewChanged"
          SizeChanged="PdfScrollViewer_SizeChanged">
          <Grid x:Name="ContentGrid">
            <!-- Page list.  Its own scrolling is disabled — it lives inside
                 the outer ScrollView, which therefore hands it an effectively
                 infinite viewport: every container is realized up front and
                 the extent is exact (no average-size estimation).  High-res
                 rendering is driven from ScrollView.ViewChanged instead of
                 element realization (see EnsureVisiblePagesHighRes). -->
            <ListView
              x:Name="PagesList"
              Margin="32,0"
              Padding="0"
              HorizontalAlignment="Center"
              Background="Transparent"
              BorderThickness="0"
              IsItemClickEnabled="False"
              IsTabStop="False"
              ItemContainerStyle="{StaticResource PageItemContainerStyle}"
              ItemsSource="{x:Bind VirtualizingImages, Mode=OneWay}"
              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
              ScrollViewer.HorizontalScrollMode="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Hidden"
              ScrollViewer.VerticalScrollMode="Disabled"
              ScrollViewer.ZoomMode="Disabled"
              SelectionMode="None">
              <!-- No entrance/content transitions — a high-res bitmap swap
                   must replace the placeholder instantly, not fade in. -->
              <ListView.ItemContainerTransitions>
                <ContentThemeTransition/>
              </ListView.ItemContainerTransitions>

              <ListView.ItemTemplate>
                <DataTemplate>
                  <Border Width="{Binding ContainerWidth}">
                    <Image Source="{Binding Image}"
                           Width="{Binding Width}"
                           Height="{Binding Height}"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"/>
                  </Border>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>

            <!-- Persistent highlight overlay. Hosts composition SpriteVisuals
                 with a Win2D Multiply BlendEffect against a backdrop brush,
                 so black text stays black. IsHitTestVisible="False" so pointer
                 events pass through to ScrollView. -->
            <Canvas
              x:Name="PersistentHighlightOverlay"
              IsHitTestVisible="False"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"/>

            <!-- Text-selection highlight overlay — drawn on top of all pages.
                 IsHitTestVisible="False" so pointer events pass through to ScrollView. -->
            <Canvas
              x:Name="HighlightOverlay"
              IsHitTestVisible="False"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"/>
          </Grid>
        </ScrollView>
      </Grid>

      <!-- TOC pane: a plain floating panel above the PDF content.  Unlike
           SplitView's overlay mode it only hit-tests within its own bounds,
           so scrolling and text selection keep working everywhere else. -->
      <Border
        x:Name="TocPane"
        Width="300"
        HorizontalAlignment="Left"
        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,0,1,0"
        Visibility="Collapsed">
        <Border.Transitions>
          <TransitionCollection>
            <EdgeUIThemeTransition Edge="Left"/>
          </TransitionCollection>
        </Border.Transitions>
        <Grid>
          <TreeView
            x:Name="TocTree"
            x:FieldModifier="public"
            ItemInvoked="TocTree_ItemInvoked"
            SelectionMode="None"
            Padding="0,8"/>
          <TextBlock
            x:Name="TocEmptyLabel"
            Text="本文档没有目录"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
