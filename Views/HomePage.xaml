<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="pdf_studio.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:pdf_studio.Views">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- App Title -->
        <TextBlock Grid.Row="0"
                   Text="PDF Studio"
                   FontSize="36"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="Open a PDF file to get started"
                   FontSize="16"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,32"/>

        <!-- Open PDF Button -->
        <Button Grid.Row="2"
                x:Name="OpenPdfButton"
                Content="&#xE8A5;  Open PDF"
                FontSize="16"
                HorizontalAlignment="Center"
                Padding="24,12"
                CornerRadius="8"
                Click="OpenPdfButton_Click"/>

        <!-- Recent Files Section -->
        <StackPanel Grid.Row="3" Margin="0,48,0,0" Visibility="Collapsed" x:Name="RecentFilesSection">
            <TextBlock Text="Recent Files"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <ListView x:Name="RecentFilesListView"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="RecentFilesListView_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- File icon -->
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE8A5;"
                                      FontSize="20"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <!-- File info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding OpenedTime}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Remove button -->
                            <Button Grid.Column="2"
                                    Content="&#xE711;"
                                    FontSize="12"
                                    Background="Transparent"
                                    Padding="4"
                                    Click="RemoveHistoryItem_Click"
                                    Tag="{Binding FilePath}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
